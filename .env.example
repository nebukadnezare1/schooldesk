POSTGRES_DB=ecole_garden
POSTGRES_USER=ecole_garden
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ecole_garden:change-me@postgres:5432/ecole_garden?schema=public
BACKEND_PORT=3000
FRONTEND_PORT=8080
# Doit être l'adresse publique réelle utilisée pour accéder au site (ex. en production derrière
# un tunnel : https://votre-domaine.example) — le backend refuse (500) toute requête dont l'en-
# tête Origin ne correspond ni à cette valeur ni à une IP de réseau local, voir CLAUDE.md §2/§9.
CORS_ORIGIN=http://localhost:8080
# API_URL n'est plus utilisé depuis le 28/08 (voir CLAUDE.md §2) : Nginx sert le frontend et
# proxifie /api/ vers le backend en interne, le frontend appelle toujours l'API en relatif
# (/api). Cette variable ne sert plus à rien, gardée ici uniquement pour ne pas casser un .env
# existant qui la définirait encore.
NODE_ENV=production
ADMIN_EMAIL=admin@ecole-garden.local
ADMIN_PASSWORD=change-this-password

# Envoi du code de vérification par email à l'inscription d'une nouvelle école.
# Avec Gmail : générer un "mot de passe d'application" (myaccount.google.com/apppasswords),
# PAS le mot de passe du compte Google lui-même.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM=SchoolDesk <votre-adresse@gmail.com>
