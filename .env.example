POSTGRES_DB=ecole_garden
POSTGRES_USER=ecole_garden
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ecole_garden:change-me@postgres:5432/ecole_garden?schema=public
BACKEND_PORT=3000
FRONTEND_PORT=8080
NODE_ENV=production

# À mettre à "true" UNIQUEMENT sur un déploiement réellement servi en HTTPS (ex. le NAS, derrière
# le tunnel Cloudflare) — active l'attribut Secure sur le cookie de session. Laisser à "false" (ou
# absent) en local/développement sur http://localhost:8080 : un cookie Secure y serait refusé par
# le navigateur (connexion non chiffrée), ce qui casserait la connexion.
COOKIE_SECURE=false

# Obligatoires lors de la toute première installation (base de données vide) : le premier compte
# administrateur est créé à partir de ces deux variables. Aucun identifiant par défaut n'existe —
# sans elles, le démarrage échoue explicitement plutôt que de créer un compte prévisible. Sans
# effet sur une installation déjà existante (au moins une école déjà créée).
ADMIN_EMAIL=admin@votre-domaine.example
ADMIN_PASSWORD=change-me-to-a-strong-password

# Doit être l'adresse publique réelle utilisée pour accéder au site (ex. en production derrière
# un tunnel : https://votre-domaine.example) — le backend refuse (500) toute requête dont l'en-
# tête Origin ne correspond ni à cette valeur ni à une IP de réseau local.
CORS_ORIGIN=http://localhost:8080

# Envoi du code de vérification par email à l'inscription d'une nouvelle école.
# Avec Gmail : générer un "mot de passe d'application" (myaccount.google.com/apppasswords),
# PAS le mot de passe du compte Google lui-même.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM=SchoolDesk <votre-adresse@gmail.com>

# Sauvegarde automatique de la base PostgreSQL complète (service db-backup) — toutes optionnelles.
# Les identifiants de connexion sont repris de POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB ci-dessus.
# Dossier de l'hôte où sont écrits les dumps (relatif au dossier du projet, ou chemin absolu).
DB_BACKUP_HOST_DIR=./storage/db-backups
# Nombre de sauvegardes conservées (les plus anciennes sont supprimées automatiquement).
DB_BACKUP_RETENTION=14
# Fuseau horaire utilisé pour la date du jour et le nom des fichiers (ex. Africa/Casablanca).
DB_BACKUP_TZ=UTC
# Intervalle (secondes) entre deux vérifications "la sauvegarde du jour existe-t-elle ?".
DB_BACKUP_CHECK_INTERVAL=3600
