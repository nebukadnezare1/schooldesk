generator client {
  provider = "prisma-client-js"
}

enum EmployeeType {
  TEACHER
  DIRECTOR
  ASSISTANT
  ADMINISTRATION
  OTHER
}

enum ExpenseCategoryStatus {
  ACTIVE
  INACTIVE
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

enum PayrollStatus {
  TO_PAY
  PARTIALLY_PAID
  PAID
}

enum SalaryAdvanceStatus {
  OPEN
  RECOVERED
  CANCELLED
}

// Not scoped by schoolId on purpose — no school exists yet when a code is requested/verified,
// same category as School/Role/Permission (see tenant-db.ts), accessed via the raw prisma client.
model RegistrationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
}

model School {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  academicYears     AcademicYear[]
  classes           SchoolClass[]
  students          Student[]
  guardians         Guardian[]
  enrollments       Enrollment[]
  employees         Employee[]
  attendances       Attendance[]
  employeeAttendances EmployeeAttendance[]
  feeTypes          FeeType[]
  studentFees       StudentFee[]
  payments          Payment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  payrolls          Payroll[]
  payrollPayments   PayrollPayment[]
  salaryAdvances    SalaryAdvance[]
  cashTransactions  CashTransaction[]
  settings          Setting[]
  numberSequences   NumberSequence[]
}

// Dedicated, monotonic per-school/per-series counter for receipt-style numbers (Payment,
// Expense, PayrollPayment). Deliberately excluded from backup export/restore (see backup.ts) —
// unlike the 20 restorable tables, this counter must NEVER be rolled back by a restore, or a
// number issued after the backup snapshot (now wiped by the restore) could be reissued to a
// different, unrelated record. `series` values in use: "PAY", "DEP", "BUL".
model NumberSequence {
  id        String   @id @default(uuid())
  schoolId  String
  series    String
  lastValue Int      @default(0)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt

  @@unique([schoolId, series])
  @@index([schoolId])
}

model ExpenseCategory {
  id        String               @id @default(uuid())
  schoolId  String
  name      String
  status    ExpenseCategoryStatus @default(ACTIVE)
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  expenses  Expense[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Expense {
  id           String          @id @default(uuid())
  schoolId     String
  number       String
  occurredAt   DateTime        @default(now())
  categoryId   String
  description  String
  beneficiary  String?
  amount       Decimal         @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  comment      String?
  recordedById String
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy   User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  cancelledBy  User?           @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cashTransaction CashTransaction?
  createdAt    DateTime        @default(now())

  @@unique([schoolId, number])
  @@index([schoolId])
  @@index([occurredAt])
  @@index([categoryId])
}

model Payroll {
  id           String       @id @default(uuid())
  schoolId     String
  employeeId   String
  month        String
  baseSalary   Decimal      @db.Decimal(12, 2)
  bonuses      Decimal      @default(0) @db.Decimal(12, 2)
  advances     Decimal      @default(0) @db.Decimal(12, 2)
  deductions   Decimal      @default(0) @db.Decimal(12, 2)
  netSalary    Decimal      @db.Decimal(12, 2)
  amountPaid   Decimal      @default(0) @db.Decimal(12, 2)
  status       PayrollStatus @default(TO_PAY)
  paidAt       DateTime?
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cashTransactions CashTransaction[]
  payments     PayrollPayment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([employeeId, month])
  @@index([schoolId])
  @@index([month, status])
}

model PayrollPayment {
  id            String        @id @default(uuid())
  schoolId      String
  payrollId     String
  receiptNumber String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  recordedById  String
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payroll       Payroll       @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  recordedBy    User          @relation("PayrollPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  cancelledBy   User?         @relation("PayrollPaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([payrollId])
}

model SalaryAdvance {
  id              String             @id @default(uuid())
  schoolId        String
  employeeId      String
  occurredAt      DateTime           @default(now())
  amount          Decimal            @db.Decimal(12, 2)
  reason          String?
  recoveryMonth   String
  status          SalaryAdvanceStatus @default(OPEN)
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledById   String?
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cancelledBy     User?              @relation("SalaryAdvanceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([schoolId])
  @@index([employeeId, recoveryMonth])
}

model CashTransaction {
  id           String              @id @default(uuid())
  schoolId     String
  type         CashTransactionType
  occurredAt   DateTime            @default(now())
  amount       Decimal             @db.Decimal(12, 2)
  description  String
  sourceType   String
  sourceId     String
  expenseId    String?             @unique
  payrollId    String?
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  expense      Expense?            @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  payroll      Payroll?            @relation(fields: [payrollId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([schoolId])
  @@index([occurredAt, type])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Employee {
  id             String           @id @default(uuid())
  schoolId       String
  matricule      String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  address        String?
  type           EmployeeType
  qualification  String?
  hiredAt        DateTime?
  baseSalary     Decimal?         @db.Decimal(12, 2)
  contractType   String?
  status         EmployeeStatus   @default(ACTIVE)
  notes          String?
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacherClasses SchoolClass[]    @relation("ClassTeacher")
  assistantClasses SchoolClass[]  @relation("ClassAssistant")
  attendances    EmployeeAttendance[]
    payrolls       Payroll[]
    salaryAdvances SalaryAdvance[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([schoolId, matricule])
  @@index([schoolId])
  @@index([lastName, firstName])
  @@index([type, status])
}

model Attendance {
  id         String           @id @default(uuid())
  schoolId   String
  studentId  String
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  recordedById String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([date, status])
}

model EmployeeAttendance {
  id         String           @id @default(uuid())
  schoolId   String
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  recordedById String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  recordedBy User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([schoolId])
  @@index([date, status])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  FUTURE
  ACTIVE
  CLOSED
}

enum SchoolClassStatus {
  ACTIVE
  INACTIVE
}

enum StudentSex {
  FEMALE
  MALE
  UNSPECIFIED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  PENDING
  LEFT
  ARCHIVED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
  OTHER
}

enum FeeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  EXEMPT
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  OTHER
}

model FeeType {
  id           String       @id @default(uuid())
  schoolId     String
  name         String
  defaultAmount Decimal     @db.Decimal(12, 2)
  frequency    FeeFrequency @default(ONE_TIME)
  isMandatory  Boolean      @default(false)
  isActive     Boolean      @default(true)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentFees  StudentFee[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model StudentFee {
  id             String       @id @default(uuid())
  schoolId       String
  studentId      String
  feeTypeId      String
  academicYearId String
  period         String
  expectedAmount Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal      @db.Decimal(12, 2)
  dueDate        DateTime
  status         FeeStatus    @default(UNPAID)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeType        FeeType      @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, feeTypeId, academicYearId, period])
  @@index([schoolId])
  @@index([academicYearId, dueDate])
  @@index([status])
}

model Payment {
  id          String             @id @default(uuid())
  schoolId    String
  receiptNumber String
  studentId   String
  guardianId  String?
  paidAt      DateTime           @default(now())
  amount      Decimal            @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  comment     String?
  recordedById String
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian    Guardian?          @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  recordedBy  User               @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  cancelledBy User?              @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  createdAt   DateTime           @default(now())

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId, paidAt])
  @@index([paidAt])
}

model PaymentAllocation {
  id          String      @id @default(uuid())
  paymentId   String
  studentFeeId String
  amount      Decimal     @db.Decimal(12, 2)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  studentFee  StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, studentFeeId])
  @@index([studentFeeId])
}

model Student {
  id               String             @id @default(uuid())
  schoolId         String
  matricule        String
  firstName        String
  lastName         String
  sex              StudentSex         @default(UNSPECIFIED)
  birthDate        DateTime
  birthPlace       String?
  nationality      String?
  address          String?
  monthlyFee       Decimal?           @db.Decimal(12, 2)
  insuranceFee     Decimal?           @db.Decimal(12, 2)
  registrationDate DateTime           @default(now())
  status           StudentStatus      @default(ACTIVE)
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  guardians        StudentGuardian[]
  enrollments      Enrollment[]
    attendances      Attendance[]
    studentFees      StudentFee[]
    payments         Payment[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([schoolId, matricule])
  @@index([schoolId])
  @@index([lastName, firstName])
  @@index([status])
}

model Guardian {
  id                   String             @id @default(uuid())
  schoolId             String
  firstName            String
  lastName             String
  primaryPhone         String
  secondaryPhone       String?
  whatsapp             String?
  email                String?
  address              String?
  profession           String?
  school               School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentLinks         StudentGuardian[]
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([schoolId])
  @@index([lastName, firstName])
  @@index([primaryPhone])
}

model StudentGuardian {
  studentId           String
  guardianId          String
  relationship        GuardianRelationship
  isPrimaryContact    Boolean            @default(false)
  authorizedToCollect Boolean            @default(true)
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian            Guardian           @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Enrollment {
  id             String           @id @default(uuid())
  schoolId       String
  studentId      String
  academicYearId String
  schoolClassId  String
  enrolledAt     DateTime         @default(now())
  endedAt        DateTime?
  status         EnrollmentStatus @default(ACTIVE)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass    SchoolClass      @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([schoolClassId])
  @@index([academicYearId])
}

model AcademicYear {
  id        String            @id @default(uuid())
  schoolId  String
  label     String
  status    AcademicYearStatus @default(FUTURE)
  startsAt  DateTime
  endsAt    DateTime
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes   SchoolClass[]
  enrollments Enrollment[]
  studentFees StudentFee[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([schoolId, label])
  @@index([schoolId])
}

model SchoolClass {
  id             String            @id @default(uuid())
  schoolId       String
  name           String
  level          String
  room           String?
  capacity       Int
  status         SchoolClassStatus @default(ACTIVE)
  academicYearId String
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
    enrollments    Enrollment[]
    teacherId      String?
    assistantId    String?
    teacher        Employee?         @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
    assistant      Employee?         @relation("ClassAssistant", fields: [assistantId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String        @id @default(uuid())
  schoolId     String
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  roleId       String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  role         Role          @relation(fields: [roleId], references: [id])
  sessions     UserSession[]
    recordedAttendances Attendance[]
    recordedEmployeeAttendances EmployeeAttendance[]
    recordedPayments Payment[] @relation("PaymentRecordedBy")
    cancelledPayments Payment[] @relation("PaymentCancelledBy")
    recordedExpenses Expense[] @relation("ExpenseRecordedBy")
    cancelledExpenses Expense[] @relation("ExpenseCancelledBy")
    recordedPayrollPayments PayrollPayment[] @relation("PayrollPaymentRecordedBy")
    cancelledPayrollPayments PayrollPayment[] @relation("PayrollPaymentCancelledBy")
    cancelledSalaryAdvances SalaryAdvance[] @relation("SalaryAdvanceCancelledBy")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([schoolId])
}

model UserSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  id        String   @id @default(uuid())
  schoolId  String
  key       String
  value     String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}
